<?xml version="1.0" encoding="utf-8" ?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
	<shortcut android:icon="@drawable/app_icon_rounded" android:enabled="true" android:shortcutId="icon" android:shortcutShortLabel="@string/pref_icon">
		<intent android:targetPackage="com.maxmpz.audioplayer" android:action="android.intent.action.MAIN" android:targetClass="com.maxmpz.audioplayer.preference.SettingsActivity">
			<extra android:name="open_path" android:value="ui_icon" />
		</intent>
	</shortcut>
	<shortcut android:icon="@drawable/shortcut_all_songs" android:enabled="true" android:shortcutId="library" android:shortcutShortLabel="@string/library">
		<intent android:action="com.maxmpz.audioplayer.ACTION_OPEN_LIBRARY" />
	</shortcut>
	<shortcut android:icon="@drawable/play_round_100dp" android:enabled="true" android:shortcutId="resume" android:shortcutShortLabel="@string/play">
		<intent android:action="com.maxmpz.audioplayer.API_COMMAND">
			<extra android:name="cmd" android:value="1" />
		</intent>
	</shortcut>
	<shortcut android:icon="@drawable/shortcut_search" android:enabled="true" android:shortcutId="search" android:shortcutShortLabel="@string/search">
		<intent android:action="com.maxmpz.audioplayer.ACTION_OPEN_SEARCH" />
	</shortcut>
	<shortcut android:icon="@drawable/shortcut_shuffle" android:enabled="true" android:shortcutId="shuffle" android:shortcutShortLabel="@string/shuffle_all">
		<intent android:action="com.maxmpz.audioplayer.API_COMMAND">
			<extra android:name="cmd" android:value="3" />
			<extra android:name="shuffle" android:value="1" />
		</intent>
	</shortcut>
</shortcuts>
