		</multiSwitch>
		<option checkedByDefault="true" key="more_buttons" name="@string/skin_more_buttons" overlapAttr="@attr/overlap_more_buttons" summary="@string/skin_summary_more_buttons" />
		<multiSwitch defaultValue="@attr/overlap_knobs_hilite_color" key="knob_hilite" name="@string/skin_knob_hilite">
			<option name="@string/none" overlapAttr="" />
			<option name="@string/monochromatic" overlapAttr="@attr/overlap_knobs_hilite_mono" />
			<option name="@string/colorful" overlapAttr="@attr/overlap_knobs_hilite_color" />
		</multiSwitch>
		<multiSwitch defaultValue="@attr/overlap_graphic_frs_color" key="graphic_frs_color" name="@string/skin_graphic_mode_frequency_curve">
			<option name="@string/monochromatic" overlapAttr="" />
			<option name="@string/colorful" overlapAttr="@attr/overlap_graphic_frs_color" />
		</multiSwitch>
		<multiSwitch defaultValue="" key="statusbar_bg" name="@string/skin_transparent_statusbar">
			<option name="@string/default_string" overlapStyle="" />
			<option name="@string/no_background" overlapStyle="@style/ActivityTheme_Black_NoStatusBar" />
		</multiSwitch>
		<msg line1="@string/summary_skin_transparent_statusbar" />
		<multiSwitch defaultValue="" key="navbar_bg" name="@string/skin_transparent_navbar" summary="@string/applied_on_main_screen">
			<option name="@string/default_string" overlapStyle="" />
