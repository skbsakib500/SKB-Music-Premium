<?xml version="1.0" encoding="utf-8" ?>
<skins xmlns:android="http://schemas.android.com/apk/res/android">
	<skin author="@string/pa_plugin_author" darkMode="@style/ActivityTheme_Black" description="@string/skin_lightpro_description" forceGlobalOptions="true" name="@string/skin_light" style="@style/ActivityTheme_White">
		<globalOption option="@attr/OptionRatingDisabled" overlapAttr="@attr/overlap_OptionRatingDisabled" />
		<globalOption option="@attr/OptionRatingStarsMenu" overlapAttr="@attr/overlap_OptionRatingStarsMenu" />
		<radio key="alt_layout" name="@string/layout">
			<option icon="@drawable/default_layout" name="@string/_default" overlapAttr="" summary="@string/skin_summary_default" />
			<option icon="@drawable/alt_layout" name="@string/skin_alt_layout" overlapAttr="@attr/overlap_alt_layout" summary="@string/skin_summary_alt_layout" />
			<option icon="@drawable/alt2_layout" name="@string/skin_alt_layout2" overlapAttr="@attr/overlap_alt_layout2" summary="@string/skin_summary_alt_layout2" />
		</radio>
		<msg align="top" line1="@string/skin_more_player_ui_opts_avail" />
		<multiSwitch dependency="alt_layout" key="track_labels_align" name="@string/track_labels">
			<option name="@string/_default" overlapAttr="" />
			<option name="@string/centered" overlapAttr="@attr/overlap_track_labels_centered" />
		</multiSwitch>
		<msg align="top" icon="@drawable/centered_layout" iconAlign="top" line1="@string/centered" smallLine1="@string/applied_for_alt_full" />
		<multiSwitch dependency="alt_layout" key="labels_bg" name="@string/labels_bg">
			<option name="@string/enabled" overlapAttr="" />
			<option name="@string/hidden" overlapAttr="@attr/overlap_track_labels_no_bg" />
		</multiSwitch>
		<msg align="top" line1="@string/hidden" smallLine1="@string/applied_for_alt_full" smallLine2="@string/applied_on_main_screen" smallLine3="@string/adjust_bg_hint" />
		<multiSwitch key="player_buttons_bg" name="@string/player_buttons_bg">
			<option name="@string/enabled" overlapAttr="" />
			<option name="@string/hidden" overlapAttr="@attr/overlap_player_buttons_no_bg" />
		</multiSwitch>
		<msg align="top" line1="@string/hidden" smallLine1="@string/adjust_bg_hint" />
		<multiSwitch key="mu_colors" minSdk="31" name="@string/mu_colors">
			<option name="@string/disabled" overlapStyle="" />
			<option name="@string/more_pronounced" overlapStyle="@style/ActivityTheme_White_Mu_More" />
			<option name="@string/less_pronounced" overlapStyle="@style/ActivityTheme_White_Mu_Less" />
		</multiSwitch>
		<multiSwitch defaultValue="@style/ActivityTheme_BoldFont" key="font_variant" name="@string/font">
			<option name="@string/_default" overlapStyle="@style/ActivityTheme_SystemFont" />
			<option name="@string/skin_alt_font" overlapStyle="@style/ActivityTheme_Whitepro_AltFont" />
			<option name="@string/bold" overlapStyle="@style/ActivityTheme_BoldFont" />
		</multiSwitch>
		<multiSwitch key="rounding" name="@string/skin_rounded_corners">
			<option name="@string/skin_more_rounded" overlapStyle="" />
			<option name="@string/skin_less_rounded" overlapAttr="@attr/overlap_less_rounding" />
		</multiSwitch>
		<multiSwitch defaultValue="" key="seekbar" name="@string/skin_seekbar_style">
			<option name="@string/default_string" overlapStyle="" />
			<option name="@string/skin_static_seekbar" overlapStyle="@style/ActivityTheme_Whitepro_StaticSeekbar" />
			<option name="@string/pref_plain_seekbar_with_buttons" overlapAttr="@attr/overlap_plain_seekbar" />
		</multiSwitch>
		<option checkedByDefault="true" key="more_buttons" name="@string/skin_more_buttons" overlapAttr="@attr/overlap_more_buttons" summary="@string/skin_summary_more_buttons" />
		<option checkedByDefault="false" key="light_buttons" name="@string/skin_light_buttons" overlapAttr="@attr/overlap_light_buttons" summary="@string/skin_summary_light_buttons" />
		<multiSwitch defaultValue="@attr/overlap_knobs_hilite_color" key="knob_hilite" name="@string/skin_knob_hilite">
			<option name="@string/none" overlapAttr="" />
			<option name="@string/monochromatic" overlapAttr="@attr/overlap_knobs_hilite_mono" />
			<option name="@string/colorful" overlapAttr="@attr/overlap_knobs_hilite_color" />
		</multiSwitch>
		<multiSwitch defaultValue="@attr/overlap_graphic_frs_color" key="graphic_frs_color" name="@string/skin_graphic_mode_frequency_curve">
			<option name="@string/monochromatic" overlapAttr="" />
			<option name="@string/colorful" overlapAttr="@attr/overlap_graphic_frs_color" />
		</multiSwitch>
		<option checkedByDefault="false" key="force_light_navbar" name="@string/skin_force_light_navbar" overlapStyle="@style/ActivityTheme_Whitepro_ForceLightNavbar" summary="@string/skin_summary_force_light_navbar" />
		<msg line1="@string/skin_navbar_firmware_warn" />
		<multiSwitch defaultValue="" key="navbar_bg" name="@string/skin_transparent_navbar" summary="@string/applied_on_main_screen">
			<option name="@string/default_string" overlapStyle="" />
			<option name="@string/semi_transparent" overlapAttr="@attr/overlap_transparent_navbar" />
			<option name="@string/no_background" overlapStyle="@style/ActivityTheme_Whitepro_NoMainNavbarBg" />
		</multiSwitch>
		<option checkedByDefault="false" key="navbar_offset" name="@string/skin_navbar_offset" overlapAttr="@attr/overlap_navbar_offset" summary="@string/skin_summary_navbar_offset" />
		<multiSwitch defaultValue="" key="android_navbar_bg" name="@string/android_navbar">
			<option name="@string/default_string" overlapStyle="" />
			<option name="@string/no_background" overlapStyle="@style/ActivityTheme_NoAndroidNavbarBg" />
		</multiSwitch>
	</skin>
