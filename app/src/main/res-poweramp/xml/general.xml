<?xml version="1.0" encoding="utf-8" ?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:z="http://schemas.android.com/apk/res-auto" xmlns:w="http://schemas.android.com/apk/res-auto" android:title="@string/pref_about">
	<com.maxmpz.audioplayer.preference.PowerampLogoPreference />
	<com.maxmpz.audioplayer.preference.FeaturePackRedirectPref android:icon="?settings_pak" android:title="@string/feature_packages" android:key="feature_packages" android:summary="@string/summary_feature_packages" z:target="feature_packages" />
	<com.maxmpz.audioplayer.preference.LicenseStatusPref z:skipSearch="true" />
	<Preference android:title="@string/pref_version" android:key="about_version" />
	<com.maxmpz.audioplayer.preference.UberLevelPref android:clickable="true" android:key="uber_level" />
	<PreferenceCategory android:title="@string/pref_update" android:key="updates">
		<com.maxmpz.audioplayer.preference.MultilineSwitchPreference android:title="@string/pref_check_updates" android:key="check_updates" android:summary="@string/pref_summary_check_updates" z:skipSearch="true" />
		<com.maxmpz.audioplayer.preference.MultilineSwitchPreference android:title="@string/pref_check_beta_updates" android:key="check_beta_updates" android:dependency="check_updates" z:skipSearch="true" />
		<com.maxmpz.audioplayer.preference.ProgressPreference android:persistent="false" android:title="@string/pref_check_udpate_now" android:key="check_update" />
	</PreferenceCategory>
	<PreferenceCategory android:title="@string/pref_other" android:key="other">
		<PreferenceScreen android:title="@string/pref_visit_site" android:key="visit_site_about" z:skipSearch="play,huawei">
			<intent android:action="android.intent.action.VIEW" android:data="http://powerampapp.com/" />
		</PreferenceScreen>
		<com.maxmpz.audioplayer.preference.RedirectPreference android:title="@string/pref_translations" android:key="translations" z:target="translations" />
		<Preference android:title="@string/pref_open_source_licenses" android:key="oss">
			<intent android:targetPackage="@string/edition_pak_name" android:targetClass="com.maxmpz.audioplayer.preference.SettingsLicenseActivity" />
		</Preference>
		<PreferenceScreen android:title="@string/pref_privacy_policy" android:key="privacy" z:skipSearch="true" />
	</PreferenceCategory>
	<PreferenceCategory android:title="@string/pref_addons" android:key="addons" />
</PreferenceScreen>
