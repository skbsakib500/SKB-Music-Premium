<?xml version="1.0" encoding="utf-8" ?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:gravity="fill_horizontal|center" android:id="@android:id/background" android:height="2.0dip">
		<shape android:shape="rectangle">
			<solid android:color="?colorSeekbarBg" />
			<corners android:radius="1.0dip" />
		</shape>
	</item>
	<item android:gravity="fill_horizontal|center" android:id="@android:id/progress" android:height="2.0dip">
		<scale android:scaleWidth="100%">
			<selector>
				<item android:state_enabled="false" android:drawable="@android:color/transparent" />
				<item>
					<shape android:shape="rectangle">
						<solid android:color="?colorSeekbarProgress" />
						<corners android:radius="1.0dip" />
					</shape>
				</item>
				<item>
					<shape android:shape="rectangle">
						<solid android:color="?colorSeekbarProgress" />
						<corners android:radius="1.0dip" />
					</shape>
				</item>
			</selector>
		</scale>
	</item>
</layer-list>
