<?xml version="1.0" encoding="utf-8" ?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" xmlns:w="http://schemas.android.com/apk/res-auto" android:color="?colorPrimary">
	<item android:id="@android:id/mask" android:drawable="@drawable/rounded_large" />
	<item>
		<selector android:exitFadeDuration="300">
			<item w:state_limiting="true">
				<shape>
					<corners android:radius="?corners_large" />
					<solid android:color="?colorLimiterActiveBg" />
					<stroke android:width="2.0dip" android:color="?colorLimiterActive" />
				</shape>
			</item>
			<item android:state_checked="true">
				<shape>
					<corners android:radius="?corners_large" />
					<solid android:color="?colorBgInverseChecked" />
				</shape>
			</item>
			<item android:drawable="@drawable/inverse_stroke_bg_alpha_rounded_large" />
		</selector>
	</item>
</ripple>
