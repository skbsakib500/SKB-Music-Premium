<?xml version="1.0" encoding="utf-8" ?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" style="@style/Widget2x2Layout">
	<ImageView android:id="@id/deck_bg_full" android:background="@drawable/widget_bg_max" android:backgroundTint="@android:color/system_accent2_800" android:outlineProvider="background" style="@style/Widget2x2DeckBgFull" />
	<FrameLayout android:id="@id/aa_cont_layout" android:padding="8.0dip" style="@style/Widget2x2AaContLayout">
		<FrameLayout android:id="@id/flipper_frame" style="@style/Widget2x2FlipperFrame">
			<ImageView android:id="@id/image" android:background="@drawable/widget_bg_max" android:src="@drawable/appwidget_aa" android:outlineProvider="background" style="@style/Widget2x2AA_Image" />
		</FrameLayout>
	</FrameLayout>
	<LinearLayout android:id="@id/playing_now" android:paddingLeft="18.0dip" android:paddingRight="18.0dip" android:paddingBottom="8.0dip" style="@style/Widget2x2PlayingNow">
		<FrameLayout android:id="@id/title_cont" style="@style/Widget2x2TitleCont">
			<TextView android:textSize="@dimen/widget4x1_font_size8" android:textStyle="normal" android:textColor="@android:color/system_accent2_100" android:text="Song name" android:shadowColor="#80000000" android:shadowRadius="2.0" android:fontFamily="google-sans-text-medium" style="@style/WidgetTextLine" />
		</FrameLayout>
		<FrameLayout android:id="@id/artist_and_album_cont" style="@style/Widget2x2ArtistAndAlbumCont">
