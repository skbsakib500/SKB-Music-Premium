		<ImageButton android:id="@id/ff_button" style="@style/Widget2x2FfButton" />
		<ImageButton android:id="@id/folder_next_button" style="@style/Widget2x2FolderNextButton" />
	</LinearLayout>
	<ImageButton android:id="@id/configure_button" style="@style/WidgetConfigureButton" />
