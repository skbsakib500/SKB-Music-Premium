<?xml version="1.0" encoding="utf-8" ?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
	<item android:state_checked="true" android:id="@id/checked" android:drawable="@drawable/circle_checked_1" />
	<item android:id="@id/unchecked" android:drawable="@drawable/circle_unchecked_1" />
	<transition android:drawable="@drawable/$circle_checkbox__0" android:toId="@id/unchecked" android:fromId="@id/checked" android:reversible="false" />
	<transition android:drawable="@drawable/$circle_checkbox__2" android:toId="@id/checked" android:fromId="@id/unchecked" android:reversible="false" />
</animated-selector>
