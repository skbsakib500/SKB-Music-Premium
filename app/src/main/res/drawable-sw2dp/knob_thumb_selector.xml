<?xml version="1.0" encoding="utf-8" ?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" xmlns:w="http://schemas.android.com/apk/res-auto" android:color="?colorKnobRipple">
	<item>
		<selector android:exitFadeDuration="300">
			<item android:state_enabled="false">
				<shape>
					<corners android:radius="?corners_knob_thumb" />
					<solid android:color="?colorKnobBg" />
					<stroke android:width="2.0dip" android:color="?colorKnobDisabled" />
				</shape>
			</item>
			<item w:state_locked="true">
				<shape>
					<corners android:radius="?corners_knob_thumb" />
					<solid android:color="?colorKnobBg" />
					<stroke android:width="2.0dip" android:color="?colorKnobDisabled" />
				</shape>
			</item>
			<item android:state_pressed="true">
				<shape>
					<corners android:radius="?corners_knob_thumb" />
					<solid android:color="?colorKnobBg" />
					<stroke android:width="3.5dip" android:color="?colorKnobPressed" />
				</shape>
			</item>
			<item>
				<shape>
					<corners android:radius="?corners_knob_thumb" />
					<solid android:color="?colorKnobBg" />
					<stroke android:width="2.0dip" android:color="?colorKnob" />
				</shape>
			</item>
		</selector>
	</item>
	<item android:left="@dimen/knob_thumb_indicator_left_right" android:top="@dimen/knob_thumb_indicator_top_bottom" android:right="@dimen/knob_thumb_indicator_left_right" android:bottom="@dimen/knob_thumb_indicator_top_bottom">
		<selector android:exitFadeDuration="300">
			<item android:state_enabled="false">
				<shape>
					<solid android:color="?colorKnobIndicatorDisabled" />
					<corners android:radius="2.0dip" />
				</shape>
			</item>
			<item android:state_pressed="true">
				<shape>
					<solid android:color="?colorKnobIndicatorPressed" />
					<corners android:radius="2.0dip" />
				</shape>
			</item>
			<item>
				<shape>
					<solid android:color="?colorKnobIndicator" />
					<corners android:radius="2.0dip" />
				</shape>
			</item>
		</selector>
	</item>
</ripple>
